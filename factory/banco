DROP TABLE IF EXISTS tbprodutos;

CREATE TABLE tbprodutos (
    prod_id INT AUTO_INCREMENT PRIMARY KEY, -- Importante ter um ID
    prod_nome VARCHAR(80),
    prod_descricao VARCHAR(255), -- Aumentei para caber descrições maiores
    prod_preco VARCHAR(80),
    prod_disponibilidade VARCHAR(20), -- Adicionei a coluna que faltava
    prod_foto VARCHAR(100)
);

CREATE TABLE tbvendedores (
    ven_nome VARCHAR(90) PRIMARY KEY,
    ven_senha VARCHAR(90),
    ven_cpf VARCHAR(11)
);

